    "The app, the canvas and Enjin's answers. Cards already made stay as they are.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen, lærredet og Enjins svar. Kort, der allerede er lavet, forbliver som de er."
          }
        }
      }
    },
    "The canvas didn't start": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lærredet startede ikke"
          }
        }
      }
    },
    "The human brain": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den menneskelige hjerne"
          }
        }
      }
    },
    "The key is stored in this iPad's Keychain and never leaves it except to talk to Anthropic.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøglen gemmes i denne iPads nøglering og forlader den kun for at tale med Anthropic."
          }
        }
      }
    },
    "Thinking…": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tænker…"
          }
        }
      }
    },
    "This iPad can't run Apple's on-device model.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne iPad kan ikke køre Apples model på enheden."
          }
        }
      }
    },
    "This key belongs to an organization but doesn't pick a workspace. Paste a workspace ID from the Claude Console (it starts with wrkspc_), or create a new key inside a workspace.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne nøgle hører til en organisation, men vælger ikke et workspace. Indsæt et workspace-ID fra Claude Console (det starter med wrkspc_), eller opret en ny nøgle inde i et workspace."
          }
        }
      }
    },
    "Tip: pinch a card open, or tap it and press **Dive in**, to go inside it.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: knib et kort op, eller tryk på det og vælg **Dyk ind**, for at gå ind i det."
          }
        }
      }
    },
