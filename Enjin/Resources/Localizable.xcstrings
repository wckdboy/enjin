    "Turn on Apple Intelligence in Settings to use Enjin without a key.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå Apple Intelligence til under Indstillinger for at bruge Enjin uden en nøgle."
          }
        }
      }
    },
    "Undo": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortryd"
          }
        }
      }
    },
    "Undo Enjin's last change": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortryd Enjins seneste ændring"
          }
        }
      }
    },
    "Using the key costs money on your Anthropic account. You set a daily limit; when it's reached, Enjin stops until tomorrow.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det koster penge på din Anthropic-konto at bruge nøglen. Du sætter en daglig grænse, og når den er nået, stopper Enjin til i morgen."
          }
        }
      }
    },
    "Volcanoes": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vulkaner"
          }
        }
      }
    },
    "What do you want to explore?": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad vil du udforske?"
          }
        }
      }
    },
    "What's it about?": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad handler det om?"
          }
        }
      }
    },
    "When the limit is reached, Enjin rests until tomorrow.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når grænsen er nået, hviler Enjin til i morgen."
          }
        }
      }
    },
    "When your kid asks Enjin something, what they typed and a short description of their canvas (card titles and summaries, counts of their drawings, and any text notes) are sent to Anthropic to generate an answer.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når dit barn spørger Enjin om noget, sendes det, de skrev, og en kort beskrivelse af deres lærred (kortenes titler og resuméer, antal tegninger og eventuelle tekstnoter) til Anthropic for at lave et svar."
          }
        }
      }
    },
    "Workspace ID (only if needed, wrkspc_...)": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Workspace-ID (kun hvis nødvendigt, wrkspc_...)"
          }
        }
      }
    },
    "You are here": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er her"
          }
        }
      }
    },
